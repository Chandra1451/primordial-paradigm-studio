# =============================================================================
# primordialparadigm.com: Hostinger (LiteSpeed/Apache) configuration
# Static site. No server-side code.
# =============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS and the bare domain (no www), in a single redirect
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://primordialparadigm.com/$1 [L,R=301]

  # Retired addresses (test content retired 2026-11-17; specs/50_content). Old links land somewhere useful.
  RewriteRule ^games/systemic-movement-prototype/?$ /games/ninefold-chaos/ [L,R=301]
  RewriteRule ^learn/systems-architecture-first-principles/?$ /learn/ [L,R=301]
  RewriteRule ^(explore|specimen)/?$ / [L,R=301]

  # Never serve dotfiles (.git, .env, .htaccess); allow .well-known/ for certificate renewal
  RewriteRule "(^|/)\.(?!well-known/)" - [F,L]
</IfModule>

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType font/woff2      .woff2
  AddType image/svg+xml   .svg
  AddType text/plain      .txt
  AddType application/xml .xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Pages revalidate every time, so a deploy shows immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # CSS and JS links carry a content fingerprint (?v=...), so they can be cached for a year
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fonts, icons and text files: 30 days
  <FilesMatch "\.(woff2|svg|ico|txt|xml)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Security headers. The site runs only its own scripts, styles and fonts: no inline code,
  # no third parties. tests/verify-site.mjs serves pages with this same policy.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Source and config files are never served, even if one is copied by mistake
<FilesMatch "\.(md|mjs|ts|json|lock|log|env|bak|sh|py|yml|yaml|ps1)$">
  Require all denied
</FilesMatch>
